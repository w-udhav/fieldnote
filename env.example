# Desk login. Required when the app is opened from any host other than localhost.
FIELDNOTE_PASSWORD=

# llama.cpp server used by `npm run worker`. On llm-server this is the local llama-server.
LLM_BASE_URL=http://127.0.0.1:8080
LLM_MODEL=

SENDER_NAME=
SENDER_EMAIL=
SMTP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true

RESUME_PATH=data/resume.pdf

NOTION_TOKEN=
NOTION_DATABASE_ID=

# Google Apps Script web app URL (https://script.google.com/macros/s/.../exec)
SHEETS_WEBHOOK_URL=
